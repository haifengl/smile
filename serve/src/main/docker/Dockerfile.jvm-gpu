####
# This Dockerfile builds a GPU-enabled container that runs the Quarkus
# smile-serve application in JVM mode on NVIDIA CUDA.
#
# Base image: nvidia/cuda:13.2.0-*-ubuntu24.04 (Ubuntu 24.04 + CUDA 13.2)
#
# IMPORTANT: build context must be the repository root (not serve/).
# Docker rebuilds only libsmile_torch.so. The Quarkus JVM app (including
# SafeTensors.java) is copied from serve/build/quarkus-app — so you MUST
# rebuild Java on the host before docker build, or you will ship stale jars:
#
#   ./gradlew :serve:build
#   docker build -f serve/src/main/docker/Dockerfile.jvm-gpu \
#     -t quarkus/smile-serve-gpu .
#
# Then run the container using (requires NVIDIA Container Toolkit).
# For Qwen 27B BF16 on 2x 40GB GPUs:
#   -Dsmile.chat.devices=0,7
# Or consecutive devices from a base index:
#   -Dsmile.chat.devices=0 -Dsmile.chat.tensor-parallel-size=2
#
# docker run -i --rm --gpus all -p 8888:8080 \
#   -e JAVA_OPTS_APPEND="-Dsmile.chat.model=Qwen/Qwen3.8-27B -Dsmile.chat.devices=0,7 -Dsmile.chat.max-seq-len=8192 -XX:ErrorFile=/model/hs_err_pid%p.log" \
#   -u root -v "$(pwd)/model":/model quarkus/smile-serve-gpu
#
# Optional JVM flags:
# - JAVA_OPTS: replaces the default JVM options
# - JAVA_OPTS_APPEND: appended to the default JVM options
#
# Remote debugging example:
#
# docker run -i --rm --gpus all -p 8888:8080 -p 5005:5005 \
#   -e JAVA_OPTS_APPEND="-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5005" \
#   -u root -v "$(pwd)/model":/model quarkus/smile-serve-gpu
#
###
ARG CUDA_VERSION=13.2.0
ARG TORCH_VERSION=2.13.0
ARG CU_VERSION=132

# -----------------------------------------------------------------------------
# Stage 1: build libsmile_torch against CUDA LibTorch (needs Toolkit headers)
# -----------------------------------------------------------------------------
FROM nvidia/cuda:${CUDA_VERSION}-devel-ubuntu24.04 AS smile-torch-builder

ARG TORCH_VERSION
ARG CU_VERSION
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        cmake \
        curl \
        g++ \
        make \
        unzip \
        libnccl2 \
        libnccl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /tmp
RUN curl -fsSL --retry 5 --retry-delay 10 -o /tmp/libtorch.zip \
        "https://download.pytorch.org/libtorch/cu${CU_VERSION}/libtorch-shared-with-deps-${TORCH_VERSION}%2Bcu${CU_VERSION}.zip" \
    && unzip -q -o /tmp/libtorch.zip -d /usr/local \
    && rm -f /tmp/libtorch.zip

COPY deep/src/main/cpp /src/smile_torch
WORKDIR /src/smile_torch
# Minimum CUDA arch is sm_80 (A100); also sm_90 (H100) and sm_100 (Blackwell FP4).
ENV TORCH_CUDA_ARCH_LIST="8.0 9.0 10.0"
RUN cmake -S . -B /build/cpp \
        -DCMAKE_BUILD_TYPE=Release \
        -DLIBTORCH_ROOT=/usr/local/libtorch \
        -DTORCH_CUDA_ARCH_LIST="8.0;9.0;10.0" \
        -DBUILD_TESTING=OFF \
    && cmake --build /build/cpp --config Release --parallel "$(nproc)" \
    && test -f /build/cpp/libsmile_torch.so

# -----------------------------------------------------------------------------
# Stage 2: runtime image
# -----------------------------------------------------------------------------
FROM nvidia/cuda:${CUDA_VERSION}-runtime-ubuntu24.04

ARG TORCH_VERSION
ARG CU_VERSION
ARG ORT_VERSION=1.29.0

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LANGUAGE=en_US:en \
    LC_ALL=C.UTF-8

# OpenJDK 25, native BLAS/ARPACK, and tools to unpack LibTorch / ONNX Runtime.
# On Ubuntu, libarpack2t64 links against OpenBLAS/LAPACK directly (no FlexiBLAS).
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        gzip \
        libarpack2t64 \
        libgomp1 \
        libopenblas0-pthread \
        libnccl2 \
        libnccl-dev \
        libcusparselt0 \
        libcudnn9-cuda-13 \
        libnvshmem3-cuda-13 \
        cuda-cupti-13-2 \
        openjdk-25-jre-headless \
        tar \
        unzip \
    && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-25-openjdk-amd64
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# Non-root user (UID 185 matches Quarkus UBI convention / COPY --chown below)
RUN groupadd --system --gid 185 smile \
    && useradd --system --uid 185 --gid 185 --home-dir /deployments --shell /sbin/nologin smile

# Install ONNX Runtime
RUN curl -fsSL "https://github.com/microsoft/onnxruntime/releases/download/v${ORT_VERSION}/onnxruntime-linux-x64-${ORT_VERSION}.tgz" \
    | tar -zx -C /usr/local/ \
    && mv /usr/local/onnxruntime-linux-x64-${ORT_VERSION} /usr/local/onnxruntime

# Install LibTorch (CUDA build — matches this base image / smile_torch stage)
RUN curl -fsSL --retry 5 --retry-delay 10 -o /tmp/libtorch.zip \
        "https://download.pytorch.org/libtorch/cu${CU_VERSION}/libtorch-shared-with-deps-${TORCH_VERSION}%2Bcu${CU_VERSION}.zip" \
    && unzip -q -o /tmp/libtorch.zip -d /usr/local \
    && rm -f /tmp/libtorch.zip

# CUDA image already sets CUDA library paths; append ORT + LibTorch
ENV LD_LIBRARY_PATH="/usr/local/onnxruntime/lib:/usr/local/libtorch/lib:/usr/lib/x86_64-linux-gnu/nvshmem/13${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"

# We make four distinct layers so if there are application changes the library layers can be re-used
# IMPORTANT: serve/build/quarkus-app must be rebuilt on the host after Java changes:
#   ./gradlew :serve:build
COPY --chown=185:185 serve/build/quarkus-app/lib/ /deployments/lib/
COPY --chown=185:185 serve/build/quarkus-app/*.jar /deployments/
COPY --chown=185:185 serve/build/quarkus-app/app/ /deployments/app/
COPY --chown=185:185 serve/build/quarkus-app/quarkus/ /deployments/quarkus/

# Replace any host-copied CPU stub with the CUDA-enabled library from stage 1
COPY --from=smile-torch-builder --chown=185:185 /build/cpp/libsmile_torch.so /deployments/lib/libsmile_torch.so

ENV LD_LIBRARY_PATH="/deployments/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"

# Minimal launcher (Ubuntu base has no UBI run-java.sh)
RUN printf '%s\n' \
    '#!/bin/bash' \
    'set -euo pipefail' \
    'exec java ${JAVA_OPTS:-} ${JAVA_OPTS_APPEND:-} -jar "${JAVA_APP_JAR}"' \
    > /deployments/run-java.sh \
    && chmod 0755 /deployments/run-java.sh \
    && chown 185:185 /deployments/run-java.sh

EXPOSE 8080
USER 185

ENV HF_HOME="/model/huggingface"
ENV JAVA_APP_JAR="/deployments/quarkus-run.jar"
ENV JAVA_OPTS_APPEND="${JAVA_OPTS_APPEND} -Djava.util.logging.manager=org.jboss.logmanager.LogManager --add-opens java.base/java.lang=ALL-UNNAMED --add-opens java.base/java.nio=ALL-UNNAMED --enable-native-access=ALL-UNNAMED"

ENTRYPOINT [ "/deployments/run-java.sh" ]
