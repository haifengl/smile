###
# Slim, inference-only variant of Dockerfile.native for resource-constrained systems that care about image
# size and startup latency. It serves SMILE (.sml) and ONNX models and the web UI's inference pages, and leaves
# out everything else: LibTorch/libsmile_torch.so, ONNX Runtime GenAI, and (via the `micro` Quarkus profile)
# the chat stack, auth/users and the database (H2/PostgreSQL/Hibernate). Chat endpoints return 404, and
# POST /api/v1/models/load with a chat model returns 503. Dockerfile.native is the full baseline.
#
# Two-stage in-container build: the Mandrel/GraalVM toolchain, Gradle and Node.js stay in the builder
# stage; the final image only has the native executable and the shared libraries it loads at runtime.
#
# IMPORTANT: build context must be the repository root (not serve/), because Gradle builds all modules:
#
# docker build -f serve/src/main/docker/Dockerfile.micro -t quarkus/smile-serve-native-micro .
#
# Then run the container using:
#
# docker run -i --rm -p 8888:8080 -u root -v "$(pwd)/model":/model quarkus/smile-serve-native-micro
#
# The runtime base is the Quarkus ubi10 micro image (no package manager); see the end of the builder stage for how
# the BLAS/LAPACK libraries get in.
#
# The native build needs several GB of RAM; give Docker at least 8 GB.
# You can pass extra Gradle arguments with --build-arg GRADLE_ARGS="...".
#
# Optional size trade-off: compiling for size (-Os) makes the image about 19 MB smaller (211 -> 192 MB) with the
# same startup time, but compute-heavy paths run slower (SHAP explanations ~1.75x, LDA ~1.25x, plain tree
# prediction unchanged). Opt in with:
#   --build-arg GRADLE_ARGS="-Dquarkus.native.additional-build-args-append=-Os"
#
###
ARG MANDREL_BUILDER=quay.io/quarkus/ubi10-quarkus-mandrel-builder-image:jdk-25
ARG RUNTIME_BASE=quay.io/quarkus/ubi10-quarkus-micro-image:2.0

# What the micro runtime image already provides (glibc etc.), so that only missing libraries are copied into it.
FROM ${RUNTIME_BASE} AS micro-ref

# -----------------------------------------------------------------------------
# Stage 1: build the native executable and collect the BLAS/LAPACK libraries it needs at runtime
# -----------------------------------------------------------------------------
FROM ${MANDREL_BUILDER} AS builder

ARG ORT_VERSION=1.30.0
ARG NODE_VERSION=24.11.0
ARG GRADLE_ARGS=""

USER root

# Archive tools. Node.js is needed by Quinoa for the web UI.
# The OpenMP build of OpenBLAS (the ubi10 `openblas` package itself ships no libraries) and libgomp are installed here
# only so that their files can be copied into the micro runtime image, which has no package manager. ARPACK (and
# the FlexiBLAS/EPEL packages it needs) is deliberately absent: only fit-time code (smile.manifold,
# SpectralClustering) uses it.
RUN microdnf install -y gzip tar xz findutils openblas-openmp libgomp && microdnf clean all
RUN curl -fsSL --retry 5 --retry-delay 10 "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
    | tar -xJ -C /usr/local --strip-components=1

# ONNX Runtime (libs copied to the runtime stage)
RUN curl -fsSL --retry 5 --retry-delay 10 "https://github.com/microsoft/onnxruntime/releases/download/v${ORT_VERSION}/onnxruntime-linux-x64-${ORT_VERSION}.tgz" \
    | tar -zx -C /usr/local/ \
    && mv /usr/local/onnxruntime-linux-x64-${ORT_VERSION} /usr/local/onnxruntime

# Native executable. Copy the whole repo (see .dockerignore) and build with the Gradle wrapper.
WORKDIR /src
COPY . /src
RUN (cd serve/src/main/webui && npm install)
# -Pserve.plugins= excludes optional plugins (blob-s3 / AWS SDK) from the native image.
RUN ./gradlew :serve:build -x test -Pserve.plugins= \
        -Dquarkus.profile=micro \
        -Dquarkus.native.enabled=true \
        -Dquarkus.package.jar.enabled=false \
        ${GRADLE_ARGS} \
    && cp serve/build/*-runner /tmp/application \
    && chmod 0755 /tmp/application

# Collect the BLAS/LAPACK libraries for the micro runtime image. /out mirrors the target filesystem: libopenblas (as
# the libopenblas.so name the app dlopens) plus every shared library it, the executable and ORT link against that
# the micro image lacks (micro-ref, above, shows what it already provides).
COPY --from=micro-ref /usr/lib64 /micro-lib64
RUN set -eu; \
    mkdir -p /out/usr/lib64; \
    cp -L /usr/lib64/libopenblaso.so.0 /out/usr/lib64/libopenblaso.so.0; \
    ln -s libopenblaso.so.0 /out/usr/lib64/libopenblas.so; \
    for f in /usr/lib64/libopenblaso.so.0 /usr/local/onnxruntime/lib/libonnxruntime.so /tmp/application; do \
        ldd "$f"; \
    done | awk '/=> \//{print $1, $3}' | sort -u | while read -r name path; do \
        if [ ! -e "/micro-lib64/$name" ] && [ ! -e "/out/usr/lib64/$name" ]; then cp -L "$path" "/out/usr/lib64/$name"; fi; \
    done; \
    ! ldd /usr/lib64/libopenblaso.so.0 | grep -q "not found"

# -----------------------------------------------------------------------------
# Stage 2: runtime image (micro base: no package manager, GraalVM, Gradle, Node.js, compilers or headers)
# -----------------------------------------------------------------------------
FROM ${RUNTIME_BASE}

LABEL org.opencontainers.image.title="SMILE Serve (Micro Native)" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later OR LicenseRef-SMILE-Commercial" \
      org.opencontainers.image.source="https://github.com/haifengl/smile" \
      org.opencontainers.image.url="https://www.aihalo.dev/licensing.html"

COPY --from=builder /out/ /

# Runtime libraries only (no headers, cmake files or static libs)
COPY --from=builder /usr/local/onnxruntime/lib /usr/local/onnxruntime/lib

# Create /work (owned by 1001) before the COPYs so no later layer has to chown/chmod the 148 MB executable.
RUN mkdir -p /work/lib && chown -R 1001:root /work && chmod g+rwX /work
WORKDIR /work
COPY --from=builder --chown=1001:root /tmp/application /work/application

# ORT
ENV LD_LIBRARY_PATH="/usr/local/onnxruntime/lib:/work/lib"
ENV ONNXRUNTIME_NATIVE_PATH="/usr/local/onnxruntime/lib"
ENV HF_HOME="/model/huggingface"

EXPOSE 8080
USER 1001

ENTRYPOINT ["./application", "-Dquarkus.http.host=0.0.0.0"]
