###
# This Dockerfile builds a CPU-only container that runs the Quarkus application in native (no JVM) mode.
# It is a two-stage in-container build: the Mandrel/GraalVM toolchain, Gradle, Node.js, CMake and the
# LibTorch/ONNX Runtime headers stay in the builder stage; the final image only has the native executable,
# libsmile_torch.so and the shared libraries they load at runtime.
#
# IMPORTANT: build context must be the repository root (not serve/), because Gradle builds all modules
# (core, deep, ...) and CMake compiles deep/src/main/cpp. No host-side build step is required:
#
# docker build -f serve/src/main/docker/Dockerfile.native -t quarkus/smile-serve-native .
#
# Then run the container using:
#
# docker run -i --rm -p 8888:8080 -u root -v "$(pwd)/model":/model quarkus/smile-serve-native
#
# The native build needs several GB of RAM; give Docker at least 8 GB.
# You can pass extra Gradle arguments with --build-arg GRADLE_ARGS="...".
#
###
ARG MANDREL_BUILDER=quay.io/quarkus/ubi10-quarkus-mandrel-builder-image:jdk-25
ARG RUNTIME_BASE=registry.access.redhat.com/ubi10/ubi-minimal:10.0

# -----------------------------------------------------------------------------
# Stage 1: build libsmile_torch.so (CPU) and the native executable
# -----------------------------------------------------------------------------
FROM ${MANDREL_BUILDER} AS builder

ARG TORCH_VERSION=2.14.1
ARG ORT_VERSION=1.30.0
ARG NODE_VERSION=24.11.0
ARG GENAI_VERSION=0.17.0
ARG GENAI_SHA256=482a17113556ff76c53820b801f391cdcbaac0b6c4089065182683c03fdbc8d9
ARG GRADLE_ARGS=""

USER root

# Toolchain for libsmile_torch (cmake, g++) plus archive tools. Node.js is needed by Quinoa for the web UI.
RUN microdnf install -y cmake gcc-c++ make unzip gzip tar xz findutils && microdnf clean all
RUN curl -fsSL --retry 5 --retry-delay 10 "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
    | tar -xJ -C /usr/local --strip-components=1

# CPU LibTorch (headers for compiling libsmile_torch, libs copied to the runtime stage)
RUN curl -fsSL --retry 5 --retry-delay 10 -o /tmp/libtorch.zip \
        "https://download.pytorch.org/libtorch/cpu/libtorch-shared-with-deps-${TORCH_VERSION}%2Bcpu.zip" \
    && unzip -q -o /tmp/libtorch.zip -d /usr/local \
    && rm -f /tmp/libtorch.zip

# ONNX Runtime (libs copied to the runtime stage)
RUN curl -fsSL --retry 5 --retry-delay 10 "https://github.com/microsoft/onnxruntime/releases/download/v${ORT_VERSION}/onnxruntime-linux-x64-${ORT_VERSION}.tgz" \
    | tar -zx -C /usr/local/ \
    && mv /usr/local/onnxruntime-linux-x64-${ORT_VERSION} /usr/local/onnxruntime

# ONNX Runtime GenAI (libonnxruntime-genai.so): the CPU chat path. Without CUDA the chat engine loads
# pre-converted GenAI (ONNX) packages through it instead of LibTorch.
RUN curl -fsSL --retry 5 --retry-delay 10 -o /tmp/genai.tgz \
        "https://github.com/microsoft/onnxruntime-genai/releases/download/v${GENAI_VERSION}/onnxruntime-genai-${GENAI_VERSION}-linux-x64.tar.gz" \
    && echo "${GENAI_SHA256}  /tmp/genai.tgz" | sha256sum -c - \
    && mkdir -p /usr/local/onnxruntime-genai \
    && tar -zx -C /usr/local/onnxruntime-genai --strip-components=1 -f /tmp/genai.tgz \
    && rm -f /tmp/genai.tgz

# libsmile_torch.so against CPU LibTorch (CMake auto-disables the CUDA/FlashInfer sources)
COPY deep/src/main/cpp /src/smile_torch
RUN cmake -S /src/smile_torch -B /build/cpp \
        -DCMAKE_BUILD_TYPE=Release \
        -DLIBTORCH_ROOT=/usr/local/libtorch \
        -DSMILE_TORCH_USE_CUDA=OFF \
        -DBUILD_TESTING=OFF \
    && cmake --build /build/cpp --config Release --parallel "$(nproc)" \
    && test -f /build/cpp/libsmile_torch.so

# Native executable. Copy the whole repo (see .dockerignore) and build with the Gradle wrapper.
WORKDIR /src
COPY . /src
RUN (cd serve/src/main/webui && npm install)
# -Pserve.plugins= excludes optional plugins (blob-s3 / AWS SDK) from the native image.
RUN ./gradlew :serve:build -x test -Pserve.plugins= \
        -Dquarkus.profile=default \
        -Dquarkus.native.enabled=true \
        -Dquarkus.package.jar.enabled=false \
        ${GRADLE_ARGS} \
    && cp serve/build/*-runner /tmp/application \
    && chmod 0755 /tmp/application

# -----------------------------------------------------------------------------
# Stage 2: runtime image (no GraalVM, Gradle, Node.js, compilers or headers)
# -----------------------------------------------------------------------------
FROM ${RUNTIME_BASE}

USER root

# Install the OpenMP build of OpenBLAS (the ubi10 `openblas` package itself ships no libraries) for native BLAS/LAPACK and libgomp for LibTorch/OpenMP. ARPACK (and the FlexiBLAS/EPEL
# packages it needs) is deliberately absent: only fit-time code (smile.manifold, SpectralClustering) uses it.
RUN microdnf install -y openblas-openmp libgomp && microdnf clean all
# The app dlopens libopenblas.so (smile.lib.blas / smile.lib.lapack default), but the OpenMP build is named libopenblaso.
RUN ln -s libopenblaso.so.0 /usr/lib64/libopenblas.so

# Runtime libraries only (no headers, cmake files or static libs)
COPY --from=builder /usr/local/onnxruntime/lib /usr/local/onnxruntime/lib
COPY --from=builder /usr/local/onnxruntime-genai/lib/libonnxruntime-genai.so /usr/local/onnxruntime-genai/lib/libonnxruntime-genai.so
COPY --from=builder /usr/local/libtorch/lib /usr/local/libtorch/lib

# Create /work (owned by 1001) before the COPYs so no later layer has to chown/chmod the 148 MB executable.
RUN mkdir -p /work/lib && chown -R 1001:root /work && chmod g+rwX /work
WORKDIR /work
COPY --from=builder --chown=1001:root /tmp/application /work/application
COPY --from=builder --chown=1001:root /build/cpp/libsmile_torch.so /work/lib/libsmile_torch.so

# ORT + LibTorch + libsmile_torch.so
ENV LD_LIBRARY_PATH="/usr/local/onnxruntime/lib:/usr/local/onnxruntime-genai/lib:/usr/local/libtorch/lib:/work/lib"
ENV ONNXRUNTIME_NATIVE_PATH="/usr/local/onnxruntime/lib" \
    ONNXRUNTIME_GENAI_NATIVE_PATH="/usr/local/onnxruntime-genai/lib"
ENV HF_HOME="/model/huggingface"

EXPOSE 8080
USER 1001

ENTRYPOINT ["./application", "-Dquarkus.http.host=0.0.0.0"]
