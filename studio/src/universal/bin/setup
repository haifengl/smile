#!/usr/bin/env bash

echo "Installing native packages..."
if command -v brew > /dev/null; then
    brew install -q arpack
    brew install -q ripgrep
elif command -v apt-get > /dev/null; then
    sudo apt-get install -y libopenblas-dev libarpack2
    sudo apt-get install -y ripgrep
elif command -v yum > /dev/null; then
    sudo yum install -y epel-release
    sudo yum install -y openblas-devel arpack-devel
    sudo yum install -y ripgrep
elif command -v pacman > /dev/null; then
    sudo pacman -S --noconfirm openblas arpack
    sudo pacman -S --noconfirm ripgrep
else
    echo 'Unsupported Linux distribution. Please install ripgrep manually.'
fi

APP_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &> /dev/null && pwd)
VENV_DIR="$APP_DIR/../venv"
# Check if venv directory exists
if [ ! -f "$VENV_DIR/bin/activate" ]; then
    echo "Creating Python virtual environment..."
    python3 -m venv "$VENV_DIR"
    if [ $? -ne 0 ]; then
        echo "Failed to create the virtual environment. Ensure Python is installed and added to PATH."
        exit 1
    else
        echo "Virtual environment created successfully."
    fi
fi

echo "Installing Python packages..."
source "$VENV_DIR/bin/activate"
python -m pip install --upgrade pip setuptools wheel
pip install -r "$APP_DIR/../conf/requirements.txt"
pip install uv
uv tool install ty@latest --force

pip install onnxruntime
# Create a symlink to the latest libonnxruntime in the capi directory
ONNX_CAPI_DIR=`find $VENV_DIR -type d -name "capi" -path "*/onnxruntime/capi" 2>/dev/null | head -n 1`
ONNX_LIB=`ls -t ${ONNX_CAPI_DIR}/libonnxruntime.* | head -n 1`
if [ -n "$ONNX_LIB" ]; then
  if [[ "$OSTYPE" == "darwin"* ]]; then
    ln -sf `basename ${ONNX_LIB}` ${ONNX_CAPI_DIR}/libonnxruntime.dylib
  else
    ln -sf `basename ${ONNX_LIB}` ${ONNX_CAPI_DIR}/libonnxruntime.so
  fi
fi

# Install Scala CLI into the launcher's bin directory. The Studio launcher puts
# this directory on PATH, so ScalaKernel finds it without any further setup.
# The version is pinned for reproducibility; bump it deliberately.
SCALA_CLI_VERSION="1.17.1"
SCALA_CLI="$APP_DIR/scala-cli"
if command -v scala-cli > /dev/null 2>&1; then
    echo "Scala CLI is already installed: $(scala-cli version 2>/dev/null | head -n 1)"
elif [ -f "$SCALA_CLI" ]; then
    # Re-assert the executable bit rather than testing it, so a copy that lost
    # its mode is repaired instead of re-downloading ~150 MB.
    chmod +x "$SCALA_CLI" 2>/dev/null || true
    echo "Scala CLI is already installed in $APP_DIR."
else
    case "$(uname -s)-$(uname -m)" in
        Linux-x86_64)    SCALA_CLI_ASSET="scala-cli-x86_64-pc-linux.gz" ;;
        Linux-aarch64)   SCALA_CLI_ASSET="scala-cli-aarch64-pc-linux.gz" ;;
        Darwin-arm64)    SCALA_CLI_ASSET="scala-cli-aarch64-apple-darwin.gz" ;;
        Darwin-x86_64)   SCALA_CLI_ASSET="scala-cli-x86_64-apple-darwin.gz" ;;
        *)               SCALA_CLI_ASSET="" ;;
    esac

    if [ -n "$SCALA_CLI_ASSET" ]; then
        echo "Installing Scala CLI $SCALA_CLI_VERSION..."
        SCALA_CLI_URL="https://github.com/VirtusLab/scala-cli/releases/download/v${SCALA_CLI_VERSION}/${SCALA_CLI_ASSET}"
        if curl -fL "$SCALA_CLI_URL" | gzip -d > "$SCALA_CLI"; then
            chmod +x "$SCALA_CLI"
            echo "Scala CLI installed to $SCALA_CLI."
        else
            # Do not fail the whole setup: Scala is optional, the other kernels
            # still work. Remove the partial file so a later run retries.
            rm -f "$SCALA_CLI"
            echo "Failed to download Scala CLI. Scala notebooks will be unavailable."
            echo "Install it manually and add it to PATH: https://scala-cli.virtuslab.org/install"
        fi
    else
        echo "Unsupported platform for automatic Scala CLI install."
        echo "Install it manually and add it to PATH: https://scala-cli.virtuslab.org/install"
    fi
fi

