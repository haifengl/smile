<div class="code-playground glass" data-lang="{{ lang or 'java' }}"{% if binder %} data-binder="{{ binder }}"{% endif %}>
  <div class="playground-toolbar">
    <span class="lang-tab is-active">{{ (lang or 'java') | capitalize }}</span>
    <span class="toolbar-spacer"></span>
    <button type="button" class="btn btn-ghost btn-sm playground-copy">Copy</button>
    {% include "components/playground-extra-actions.njk" %}
  </div>
  <pre class="playground-source language-{{ lang or 'java' }}"><code class="language-{{ lang or 'java' }}">{{ content | safe }}</code></pre>
  <div class="playground-editor" hidden></div>
</div>
