<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <meta name="description" content="Statistical Machine Intelligence and Learning Engine">
  <script>
    (function () {
      try {
        var stored = localStorage.getItem('smile-theme');
        var theme = (stored === 'dark' || stored === 'light') ? stored : 'light';
        document.documentElement.setAttribute('data-theme', theme);
      } catch (e) {}
    })();
  </script>
  <link rel="stylesheet" href="css/site.css">
  <link rel="stylesheet" href="css/prism.min.css" id="prism-light">
  <link rel="stylesheet" href="css/prism-tomorrow.min.css" id="prism-dark" disabled>
  <script>
    (function () {
      var dark = document.documentElement.getAttribute('data-theme') === 'dark';
      var lightSheet = document.getElementById('prism-light');
      var darkSheet = document.getElementById('prism-dark');
      if (lightSheet && darkSheet) {
        lightSheet.disabled = dark;
        darkSheet.disabled = !dark;
      }
    })();
  </script>
  <script>
    (function () {
      var queued = [];
      function stub() { queued.push(arguments); }
      stub._smileQueue = true;
      window.vegaEmbed = stub;
      document.addEventListener('DOMContentLoaded', function () {
        var embed = window.vegaEmbed;
        if (typeof embed !== 'function' || embed._smileQueue) return;
        queued.forEach(function (args) { embed.apply(window, args); });
      });
    })();
  </script>
  <script defer src="https://cdn.jsdelivr.net/npm/vega@5"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/vega-lite@5"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/vega-embed@6"></script>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-57GD08QCML"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-57GD08QCML');
  </script>
</head>
<body>
  <a class="skip-link" href="#content">Skip to content</a>
  {% include "components/header.njk" %}
  <div class="site-shell" id="content">
    {{ content | safe }}
  </div>
  {% include "components/command-palette.njk" %}
  <div id="contact-modal" class="contact-modal" hidden>
    <div class="contact-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="contact-modal-title">
      <div class="contact-modal-bar">
        <div>
          <p id="contact-modal-title" class="contact-modal-title">Contact Us</p>
          <p id="contact-modal-sub" class="contact-modal-sub">Administered by HALO.AI LLC · Direct engineering &amp; commercial licensing support</p>
        </div>
        <button type="button" class="icon-btn" data-contact-close aria-label="Close">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>
      <div class="contact-modal-tabs" role="tablist" aria-label="Request type">
        <button type="button" class="contact-tab" role="tab" data-contact-tab="contact" aria-selected="false">Contact Us</button>
        <button type="button" class="contact-tab" role="tab" data-contact-tab="demo" aria-selected="false">Get a Demo</button>
        <button type="button" class="contact-tab" role="tab" data-contact-tab="pilot" aria-selected="false">Request a Pilot</button>
        <button type="button" class="contact-tab is-active" role="tab" data-contact-tab="order" aria-selected="true">Order Form</button>
      </div>
      <div class="contact-modal-body">
        <form id="order-request-form" class="order-form" data-endpoint="https://halo-order-worker.aihalo.workers.dev/v1/orders" novalidate>
          <input type="text" name="website_url" class="order-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true">
          <input type="hidden" id="order-mode" name="requestType" value="order">

          <div class="order-grid">
            <!-- General Information (All Modes) -->
            <div class="order-field">
              <label for="order-first-name">First Name <span aria-hidden="true">*</span></label>
              <input id="order-first-name" name="firstName" type="text" required placeholder="Jane">
            </div>

            <div class="order-field">
              <label for="order-last-name">Last Name <span aria-hidden="true">*</span></label>
              <input id="order-last-name" name="lastName" type="text" required placeholder="Doe">
            </div>

            <div class="order-field">
              <label for="order-email">Work Email <span aria-hidden="true">*</span></label>
              <input id="order-email" name="email" type="email" required placeholder="jane.doe@company.com">
            </div>

            <div class="order-field">
              <label for="order-customer">Company / Organization Name <span aria-hidden="true">*</span></label>
              <input id="order-customer" name="customer" type="text" required placeholder="e.g., Acme Financial Corp.">
            </div>

            <div class="order-field">
              <label for="order-role">Job Title / Role <span aria-hidden="true">*</span></label>
              <input id="order-role" name="jobTitle" type="text" required placeholder="e.g., VP Platform Engineering">
            </div>

            <div class="order-field">
              <label for="order-company-size">Company Size (Employees) <span aria-hidden="true">*</span></label>
              <select id="order-company-size" name="companySize" required>
                <option value="1 - 50">1 - 50</option>
                <option value="51 - 200">51 - 200</option>
                <option value="201 - 1,000">201 - 1,000</option>
                <option value="1,000+" selected>1,000+</option>
              </select>
            </div>

            <div class="order-field">
              <label for="order-org-type">Organization Type <span aria-hidden="true">*</span></label>
              <select id="order-org-type" name="organizationType" required>
                <option value="Enterprise Technology / Software Vendor (ISV)">Enterprise Technology / Software Vendor (ISV)</option>
                <option value="Financial Services / Fintech">Financial Services / Fintech</option>
                <option value="System Integrator / IT Consulting">System Integrator / IT Consulting</option>
                <option value="Cloud Service Provider / Data Center / Managed Infrastructure">Cloud Service Provider / Data Center / Managed Infrastructure</option>
                <option value="Research Institution / Higher Education">Research Institution / Higher Education</option>
                <option value="AI / Tech Startup">AI / Tech Startup</option>
                <option value="Other">Other</option>
              </select>
            </div>

            <div class="order-field">
              <label for="order-interest">Primary Interest / Inquiries <span aria-hidden="true">*</span></label>
              <select id="order-interest" name="primaryInterest" required>
                <option value="AI Framework Integration & Open-Source Tooling">AI Framework Integration &amp; Open-Source Tooling</option>
                <option value="High-Performance Model Serving & Inference Infrastructure">High-Performance Model Serving &amp; Inference Infrastructure</option>
                <option value="Agentic Systems & IDE / Developer Workflow Integration">Agentic Systems &amp; IDE / Developer Workflow Integration</option>
                <option value="Enterprise Platform Architecture & Managed AI Services">Enterprise Platform Architecture &amp; Managed AI Services</option>
                <option value="Custom Model Fine-Tuning, Benchmarking & Optimization">Custom Model Fine-Tuning, Benchmarking &amp; Optimization</option>
                <option value="On-Premises / Hybrid Cloud Private AI Deployment">On-Premises / Hybrid Cloud Private AI Deployment</option>
                <option value="Commercial Licensing & Enterprise Pricing Models">Commercial Licensing &amp; Enterprise Pricing Models</option>
              </select>
            </div>

            <!-- Specific Fields: Get a Demo -->
            <div class="order-field order-field-full" id="demo-specific-fields" hidden>
              <label for="demo-product">Product Focus for Demo</label>
              <select id="demo-product" name="demoProduct">
                <option value="Full Stack (Core Engine + Serve Engine + Agent Studio)">Full Stack (Core Engine + Serve Engine + Agent Studio)</option>
                <option value="SMILE Serve Engine (ML, ONNX & Local LLM Serving)">SMILE Serve Engine (ML, ONNX &amp; Local LLM Serving)</option>
                <option value="SMILE Core Engine (In-Process Low-Latency JVM ML)">SMILE Core Engine (In-Process Low-Latency JVM ML)</option>
                <option value="SMILE Agent Studio (Agentic Data Science IDE & AutoML)">SMILE Agent Studio (Agentic Data Science IDE &amp; AutoML)</option>
                <option value="Edge AI & Air-Gapped Fleet Deployment">Edge AI &amp; Air-Gapped Fleet Deployment</option>
              </select>
            </div>

            <!-- Specific Fields: Request a Pilot -->
            <div class="order-field" id="pilot-env-wrap" hidden>
              <label for="pilot-env">Target Pilot Environment</label>
              <select id="pilot-env" name="pilotEnvironment">
                <option value="On-Premises / Private Data Center">On-Premises / Private Data Center</option>
                <option value="Edge Gateways (Branch / POS / ATM / Telematics)">Edge Gateways (Branch / POS / ATM / Telematics)</option>
                <option value="Air-Gapped / Sovereign Network">Air-Gapped / Sovereign Network</option>
                <option value="Private Cloud VPC (AWS / Azure / GCP)">Private Cloud VPC (AWS / Azure / GCP)</option>
              </select>
            </div>

            <div class="order-field" id="pilot-scale-wrap" hidden>
              <label for="pilot-scale">Target Pilot Scale &amp; Program</label>
              <select id="pilot-scale" name="pilotScale">
                <option value="$15,000 30-Day Turnkey Edge Pilot (100% credited to annual contract)">$15,000 30-Day Turnkey Edge Pilot (100% credited to annual contract)</option>
                <option value="30-Day Self-Hosted Commercial Evaluation Key">30-Day Self-Hosted Commercial Evaluation Key</option>
                <option value="100 - 1,000+ Edge Nodes Fleet Scoping">100 - 1,000+ Edge Nodes Fleet Scoping</option>
              </select>
            </div>

            <!-- Specific Fields: Commercial Order Form -->
            <div class="order-field order-field-full" id="order-tier-wrap">
              <label for="order-tier">Commercial Licensing Tier <span aria-hidden="true">*</span></label>
              <select id="order-tier" name="tier">
                <option value="PRODUCTION_RUNTIME">Production Runtime — $12,000 / year (up to 4 server nodes + 5 Agent Studio seats)</option>
                <option value="OEM">OEM &amp; Embedded Distribution — $25,000 one-time (1 App line, 10 dev seats + 10 Studio seats)</option>
                <option value="ENTERPRISE">Enterprise &amp; Edge Fleet — From $50,000 / year (100–5,000+ edge nodes + 25 Studio seats)</option>
                <option value="STUDIO_TEAM">SMILE Agent Studio Team — $995 / seat / year (5-seat standalone minimum, or add-on seats)</option>
                <option value="EVALUATION_PILOT">30-Day Commercial Trial Key / $15,000 Turnkey Edge Pilot</option>
              </select>
            </div>

            <div class="order-field" id="order-nodes-wrap">
              <label for="order-nodes" id="order-nodes-label">Production Server Nodes</label>
              <input id="order-nodes" name="nodes" type="number" min="1" max="100000" value="4">
              <small id="order-nodes-hint" class="order-hint">4 nodes included in base pack (+$250/node/mo above 4)</small>
            </div>

            <div class="order-field" id="order-seats-wrap">
              <label for="order-seats" id="order-seats-label">Agent Studio Authorized User Seats</label>
              <input id="order-seats" name="seats" type="number" min="1" max="10000" value="5">
              <small id="order-seats-hint" class="order-hint">5 seats bundled free (+$995/seat/yr for extra seats)</small>
            </div>

            <div class="order-field order-field-full" id="order-billing-wrap">
              <label for="order-billing-email">Billing / Accounts Payable Email (Optional)</label>
              <input id="order-billing-email" name="billingEmail" type="email" placeholder="ap@company.com">
            </div>

            <!-- Message / Scope (All Modes) -->
            <div class="order-field order-field-full">
              <label for="order-notes" id="order-notes-label">Tell us about your technical requirements, licensing inquiries, or project scope:</label>
              <textarea id="order-notes" name="notes" rows="3" placeholder="Share your workload, latency targets, model formats (.sml, .onnx, LLM), or procurement requirements..."></textarea>
            </div>
          </div>

          <div class="order-summary" id="order-summary" aria-live="polite">
            <div>
              <span class="order-summary-kicker">Estimated Order Summary</span>
              <strong id="order-summary-title">Production Runtime (Serve + Core + 5 Studio Seats)</strong>
              <span id="order-summary-agreement" class="order-summary-meta">Governing Agreement: Serve Engine Commercial License 1.0</span>
            </div>
            <div class="order-summary-price" id="order-summary-price">$12,000 <span>/ year</span></div>
          </div>

          <p class="order-error" id="order-error" hidden role="alert"></p>

          <div class="order-actions">
            <span class="order-direct-mail">Prefer email? <a href="mailto:sales@aihalo.dev">sales@aihalo.dev</a></span>
            <div class="order-actions-right">
              <button type="button" class="btn btn-quiet" data-contact-close>Cancel</button>
              <button type="submit" class="btn btn-accent" id="order-submit-btn">Submit Request</button>
            </div>
          </div>
        </form>

        <div id="order-result" class="order-result" hidden>
          <div class="order-result-head">
            <span class="order-result-badge" id="order-result-badge">Request Ready</span>
            <h3 id="order-result-title">Your Request Has Been Prepared</h3>
            <p id="order-result-message"></p>
          </div>
          <pre class="order-result-payload"><code id="order-result-code"></code></pre>
          <div class="order-actions">
            <button type="button" class="btn btn-quiet btn-sm" id="order-copy-btn">Copy Summary</button>
            <div class="order-actions-right">
              <a class="btn btn-accent" id="order-mailto-btn" href="mailto:sales@aihalo.dev">Send via Email Client →</a>
              <button type="button" class="btn btn-quiet" data-contact-close>Done</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <script defer src="js/vendor/prism/prism.min.js"></script>
  <script defer src="js/vendor/prism/prism-clike.min.js"></script>
  <script defer src="js/vendor/prism/prism-java.min.js"></script>
  <script defer src="js/vendor/prism/prism-scala.min.js"></script>
  <script defer src="js/vendor/prism/prism-kotlin.min.js"></script>
  <script defer src="js/vendor/prism/prism-groovy.min.js"></script>
  <script defer src="js/vendor/prism/prism-clojure.min.js"></script>
  <script defer src="js/vendor/prism/prism-bash.min.js"></script>
  <script defer src="js/vendor/prism/prism-markup.min.js"></script>
  <script src="js/dedent.js"></script>
  <script src="js/toc.js"></script>
  <script src="js/site.js"></script>
  <script defer src="js/search.js"></script>
  <script src="js/playground.js"></script>
</body>
</html>
